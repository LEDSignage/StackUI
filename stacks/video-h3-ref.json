{
  "schemaVersion": 2,
  "id": "video-h3-ref",
  "name": "Make a video",
  "job": "Make a video",
  "model": "MiniMax H3 (Omni Reference)",
  "output": {
    "convertFps": 0
  },
  "controls": [
    {
      "label": "What happens",
      "tileId": "t-h3",
      "param": "prompt",
      "group": "What to make",
      "hint": "H3 takes a rich prompt — you can describe a timeline, and it generates sound too."
    },
    {
      "label": "Width",
      "tileId": "t-h3",
      "param": "width",
      "group": "Size and timing"
    },
    {
      "label": "Height",
      "tileId": "t-h3",
      "param": "height",
      "group": "Size and timing"
    },
    {
      "label": "Seconds",
      "tileId": "t-h3",
      "param": "length",
      "group": "Size and timing",
      "seconds": {
        "fps": 24,
        "step": 17,
        "offset": 5
      }
    },
    {
      "label": "Seed",
      "tileId": "t-noise",
      "param": "noise_seed",
      "group": "Quality"
    },
    {
      "label": "Steps",
      "tileId": "t-sched",
      "param": "steps",
      "group": "Quality"
    },
    {
      "label": "Reference sizing",
      "tileId": "t-h3",
      "param": "ref_image_size",
      "group": "Quality",
      "hint": "'max' sizes each reference to a 2048px short edge, independent of the output shape — better likeness, several times slower. 'match' squeezes them into the output's own pixel area, which distorts them badly on a very wide or very tall canvas."
    }
  ],
  "inputs": {
    "label": "References",
    "maxTotal": 12,
    "note": "Up to 9 images, 3 video clips and 3 audio clips — but no more than 12 files in total. References describe what things look like; they are not placed anywhere in the clip.",
    "kinds": [
      {
        "id": "ref",
        "label": "Image",
        "max": 9,
        "beforeTile": "t-h3",
        "template": [
          {
            "moduleId": "h3-ref-image-0"
          }
        ],
        "loaderByIndex": [
          "h3-ref-image-0",
          "h3-ref-image-1",
          "h3-ref-image-2",
          "h3-ref-image-3",
          "h3-ref-image-4",
          "h3-ref-image-5",
          "h3-ref-image-6",
          "h3-ref-image-7",
          "h3-ref-image-8"
        ],
        "file": {
          "index": 0,
          "param": "image"
        }
      },
      {
        "id": "refvid",
        "label": "Video",
        "max": 3,
        "beforeTile": "t-h3",
        "template": [
          {
            "moduleId": "h3-ref-video-0"
          }
        ],
        "loaderByIndex": [
          "h3-ref-video-0",
          "h3-ref-video-1",
          "h3-ref-video-2"
        ],
        "file": {
          "index": 0,
          "param": "file"
        }
      }
    ]
  },
