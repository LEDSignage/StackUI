{
  "schemaVersion": 2,
  "id": "video-h3",
  "name": "Make a video",
  "job": "Make a video",
  "model": "MiniMax H3",
  "output": {
    "convertFps": 0
  },
  "controls": [
    {
      "label": "What happens",
      "tileId": "t-h3",
      "param": "prompt",
      "group": "What to make",
      "hint": "H3 takes a rich prompt — you can describe a timeline, and it generates sound too."
    },
    {
      "label": "Width",
      "tileId": "t-h3",
      "param": "width",
      "group": "Size and timing"
    },
    {
      "label": "Height",
      "tileId": "t-h3",
      "param": "height",
      "group": "Size and timing"
    },
    {
      "label": "Seconds",
      "tileId": "t-h3",
      "param": "length",
      "group": "Size and timing",
      "seconds": {
        "fps": 24,
        "step": 17,
        "offset": 5
      }
    },
    {
      "label": "Seed",
      "tileId": "t-noise",
      "param": "noise_seed",
      "group": "Quality"
    },
    {
      "label": "Steps",
      "tileId": "t-sched",
      "param": "steps",
      "group": "Quality"
    }
  ],
  "inputs": {
    "label": "Inputs",
    "kinds": [
      {
        "id": "start",
        "label": "Start frame",
        "max": 1,
        "beforeTile": "t-h3",
        "template": [
          {
            "moduleId": "load-start-frame"
          }
        ],
        "file": {
          "index": 0,
          "param": "image"
        }
      },
      {
        "id": "end",
        "label": "End frame",
        "max": 1,
        "beforeTile": "t-h3",
        "template": [
          {
            "moduleId": "load-end-frame"
          }
        ],
        "file": {
          "index": 0,
          "param": "image"
        }
      }
    ]
  },
  "lines": [
    {
      "id": "l1",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-unet",
          "moduleId": "gen.UNETLoader",
          "params": {
            "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
            "weight_dtype": "default"
          },
          "collapsed": true
        },
        {
          "id": "t-clip",
          "moduleId": "gen.CLIPLoader",
          "params": {
            "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
            "type": "minimax",
            "device": "default"
          },
          "collapsed": true
        },
        {
          "id": "t-vae",
          "moduleId": "gen.VAELoader",
          "params": {
            "vae_name": "minimax_h3_video_vae_fp16.safetensors"
          },
          "collapsed": true
        },
        {
          "id": "t-avae",
          "moduleId": "h3-audio-vae",
          "params": {
            "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
          },
          "collapsed": true
        }
      ]
    },
    {
      "id": "l3",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-h3",
          "moduleId": "gen.MiniMaxH3ImageToVideo",
          "params": {
            "prompt": "Warm evening light, shallow depth of field, unhurried.\n\nTimeline:\n[0s-2s] The sign fills the frame, light catching its edge.\n[2s-5s] Slow drift back, the street coming into view behind it.\n\nNo cuts, no camera shake, no text overlays.\n\nAudio: Low room tone, distant traffic, no music.",
            "width": 1344,
            "height": 768,
            "length": 124
          },
          "collapsed": false
        }
      ]
    },
    {
      "id": "l4",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-guider",
          "moduleId": "gen.BasicGuider",
          "params": {},
          "collapsed": true
        },
        {
          "id": "t-sampler",
          "moduleId": "gen.KSamplerSelect",
          "params": {
            "sampler_name": "res_multistep"
          },
          "collapsed": true
        },
        {
          "id": "t-sched",
          "moduleId": "gen.BasicScheduler",
          "params": {
            "scheduler": "simple",
            "steps": 20,
            "denoise": 1
          },
          "collapsed": true
        },
        {
          "id": "t-noise",
          "moduleId": "gen.RandomNoise",
          "params": {
            "noise_seed": 1234
          },
          "collapsed": true
        }
      ]
    },
    {
      "id": "l5",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-sample",
          "moduleId": "sample-advanced",
          "params": {},
          "collapsed": true
        }
      ]
    },
    {
      "id": "l6",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-decode",
          "moduleId": "gen.VAEDecode",
          "params": {},
          "collapsed": true
        },
        {
          "id": "t-decode-audio",
          "moduleId": "decode-audio",
          "params": {},
          "collapsed": true
        }
      ]
    },
    {
      "id": "l7",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-video",
          "moduleId": "create-video",
          "params": {
            "fps": 24,
            "bit_depth": 8
          },
          "collapsed": true
        }
      ]
    },
    {
      "id": "l8",
      "mode": "parallel",
      "bypassed": false,
      "tiles": [
        {
          "id": "t-save",
          "moduleId": "gen.SaveVideo",
          "params": {
            "filename_prefix": "StackUI/h3",
            "format": "auto",
            "codec": "auto"
          },
          "collapsed": true
        }
      ]
    }
  ],
  "script": {
    "target": {
      "tileId": "t-h3",
      "param": "prompt"
    },
    "vision": "Warm evening light, shallow depth of field, unhurried.",
    "shots": [
      {
        "from": 0,
        "to": 2,
        "text": "The sign fills the frame, light catching its edge."
      },
      {
        "from": 2,
        "to": 5,
        "text": "Slow drift back, the street coming into view behind it."
      }
    ],
    "audio": "Low room tone, distant traffic, no music.",
    "rules": "No cuts, no camera shake, no text overlays."
  }
}