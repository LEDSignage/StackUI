{
  "id": "upscale-image",
  "name": "Upscale",
  "category": "image",
  "description": "ImageScaleBy — plain resampling, no model. Safe to bypass.",
  "inPorts": [{ "name": "image", "type": "IMAGE" }],
  "outPorts": [{ "name": "image", "type": "IMAGE" }],
  "outputs": { "image": { "node": "up" } },
  "passThrough": { "image": "image" },
  "summary": ["scale_by", "upscale_method"],
  "params": [
    {
      "name": "scale_by",
      "label": "Scale",
      "type": "FLOAT",
      "default": 2.0,
      "min": 0.1,
      "max": 8,
      "step": 0.1,
      "target": { "node": "up", "input": "scale_by" }
    },
    {
      "name": "upscale_method",
      "label": "Method",
      "type": "ENUM",
      "default": "lanczos",
      "optionsFrom": { "class_type": "ImageScaleBy", "input": "upscale_method" },
      "target": { "node": "up", "input": "upscale_method" }
    }
  ],
  "nodes": {
    "up": {
      "class_type": "ImageScaleBy",
      "inputs": { "image": { "$port": "image" }, "upscale_method": "lanczos", "scale_by": 2.0 }
    }
  }
}
