{
  "id": "gen.EasyCache",
  "name": "EasyCache",
  "category": "ComfyUI / advanced/debug",
  "description": "EasyCache — Native EasyCache implementation.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "params": [
    {
