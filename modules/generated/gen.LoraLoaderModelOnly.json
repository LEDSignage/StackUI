{
  "id": "gen.LoraLoaderModelOnly",
  "name": "Load LoRA",
  "category": "ComfyUI / model/loaders",
  "description": "LoraLoaderModelOnly — This LoRAs loader is used to modify the diffusion model, altering the way in which latents are denoised such as applying styles. Multiple LoRA nodes can be linked together.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "params": [
    {
      "name": "lora_name",
      "label": "Lora name",
      "target": {
        "node": "n",
        "input": "lora_name"
      },
      "type": "ENUM",
      "default": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
      "options": [
        "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
        "gemma-3-12b-it-abliterated_lora_rank64_bf16.safetensors",
        "ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors",
        "ltx_2.3_22b_distilled_1.1_lora_dynamic_fro09_avg_rank_111_bf16.safetensors"
      ],
      "optionsFrom": {
        "class_type": "LoraLoaderModelOnly",
        "input": "lora_name"
      }
    },
    {
      "name": "strength_model",
      "label": "Strength model",
      "target": {
        "node": "n",
        "input": "strength_model"
      },
      "type": "FLOAT",
      "default": 1,
      "min": -100,
      "max": 100,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
        "strength_model": 1
      }
    }
  },
  "outputs": {
    "model": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "model": "model"
  },
  "summary": [
    "lora_name",
    "strength_model"
  ]
}
