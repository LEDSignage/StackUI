{
  "id": "gen.CFGOverride",
  "name": "CFG Override",
  "category": "ComfyUI / model/sampling/guiders",
  "description": "CFGOverride — Override cfg to a fixed value over a [start, end] percent (sigma) range. With multiple overrides, the one nearest the sampler wins on overlap.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "params": [
    {
      "name": "cfg",
      "label": "Cfg",
      "target": {
        "node": "n",
        "input": "cfg"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0,
      "max": 100,
      "step": 0.1
    },
    {
      "name": "start_percent",
      "label": "Start percent",
      "target": {
        "node": "n",
        "input": "start_percent"
      },
      "type": "FLOAT",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.001
    },
    {
      "name": "end_percent",
      "label": "End percent",
      "target": {
        "node": "n",
        "input": "end_percent"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.001
    }
  ],
  "nodes": {
    "n": {
      "class_type": "CFGOverride",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "cfg": 1,
        "start_percent": 0,
        "end_percent": 1
      }
    }
  },
  "outputs": {
    "model": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "model": "model"
  },
  "summary": [
    "cfg",
    "start_percent",
    "end_percent"
  ]
}
