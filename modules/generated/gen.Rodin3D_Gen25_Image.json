      "target": {
        "node": "n",
        "input": "mode"
      },
      "type": "ENUM",
      "default": "Regular",
      "options": [
        "Regular",
        "Fast",
        "Extreme-High"
      ],
      "optionsFrom": {
        "class_type": "Rodin3D_Gen25_Image",
        "input": "mode"
      }
    },
    {
      "name": "material",
      "label": "Material",
      "target": {
        "node": "n",
        "input": "material"
      },
      "type": "ENUM",
