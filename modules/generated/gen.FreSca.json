{
  "id": "gen.FreSca",
  "name": "FreSca",
  "category": "ComfyUI / experimental",
  "description": "FreSca — Applies frequency-dependent scaling to the guidance",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "params": [
    {
      "name": "scale_low",
      "label": "Scale low",
      "target": {
        "node": "n",
        "input": "scale_low"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0,
      "max": 10,
      "step": 0.01
    },
    {
      "name": "scale_high",
      "label": "Scale high",
      "target": {
        "node": "n",
        "input": "scale_high"
      },
      "type": "FLOAT",
      "default": 1.25,
      "min": 0,
      "max": 10,
      "step": 0.01
    },
    {
      "name": "freq_cutoff",
      "label": "Freq cutoff",
      "target": {
        "node": "n",
        "input": "freq_cutoff"
      },
      "type": "INT",
      "default": 20,
      "min": 1,
      "max": 10000,
      "step": 1
    }
  ],
  "nodes": {
    "n": {
      "class_type": "FreSca",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "scale_low": 1,
        "scale_high": 1.25,
        "freq_cutoff": 20
      }
    }
  },
  "outputs": {
    "model": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "model": "model"
  },
  "summary": [
    "scale_low",
    "scale_high",
    "freq_cutoff"
  ]
}
