      "name": "prompt",
      "label": "Prompt",
      "target": {
        "node": "n",
        "input": "prompt"
      },
      "type": "STRING",
      "default": "",
      "multiline": true
    },
    {
      "name": "alpha_mode",
      "label": "Alpha mode",
      "target": {
        "node": "n",
        "input": "alpha_mode"
      },
      "type": "ENUM",
      "default": "auto",
      "options": [
        "auto",
        "fill",
        "select",
        "custom"
      ],
      "optionsFrom": {
