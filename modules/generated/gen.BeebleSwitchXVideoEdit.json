{
  "id": "gen.BeebleSwitchXVideoEdit",
  "name": "Beeble SwitchX Video Edit",
  "category": "ComfyUI / partner/video/Beeble",
  "description": "BeebleSwitchXVideoEdit — Edit a video with Beeble SwitchX. Switches anything in the scene (background, lighting, costume) while preserving the original subject's pixels and motion. Provide a reference image and/or text prompt to describe the new look. Max 240 frames, max ~2.77MP per frame.",
