{
  "id": "gen.NAGuidance",
  "name": "Normalized Attention Guidance",
  "category": "ComfyUI / advanced/guidance",
  "description": "NAGuidance — Applies Normalized Attention Guidance to models, enabling negative prompts on distilled/schnell models.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    }
  ],
  "params": [
    {
      "name": "nag_scale",
      "label": "Nag scale",
      "target": {
        "node": "n",
        "input": "nag_scale"
      },
      "type": "FLOAT",
      "default": 5,
      "min": 0,
      "max": 50,
      "step": 0.1
    },
    {
      "name": "nag_alpha",
      "label": "Nag alpha",
      "target": {
        "node": "n",
        "input": "nag_alpha"
      },
      "type": "FLOAT",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "nag_tau",
      "label": "Nag tau",
      "target": {
        "node": "n",
        "input": "nag_tau"
      },
      "type": "FLOAT",
      "default": 1.5,
      "min": 1,
      "max": 10,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "NAGuidance",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "nag_scale": 5,
        "nag_alpha": 0.5,
        "nag_tau": 1.5
      }
    }
  },
  "outputs": {
    "model": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "model": "model"
  },
  "summary": [
    "nag_scale",
    "nag_alpha",
    "nag_tau"
  ]
}
