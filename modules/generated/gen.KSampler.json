{
  "id": "gen.KSampler",
  "name": "KSampler",
  "category": "ComfyUI / model/sampling",
  "description": "KSampler — Uses the provided model, positive and negative conditioning to denoise the latent image.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    },
    {
      "name": "positive",
      "type": "CONDITIONING"
    },
    {
      "name": "negative",
      "type": "CONDITIONING"
    },
    {
      "name": "latent_image",
      "type": "LATENT"
    }
  ],
  "outPorts": [
    {
      "name": "latent",
      "type": "LATENT"
    }
  ],
  "params": [
    {
      "name": "seed",
      "label": "Seed",
      "target": {
        "node": "n",
        "input": "seed"
      },
      "type": "INT",
      "default": 0,
      "min": 0
    },
    {
      "name": "steps",
      "label": "Steps",
      "target": {
        "node": "n",
        "input": "steps"
      },
      "type": "INT",
      "default": 20,
      "min": 1,
      "max": 10000
