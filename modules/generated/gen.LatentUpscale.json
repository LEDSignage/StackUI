        "node": "n",
        "input": "upscale_method"
      },
      "type": "ENUM",
      "default": "nearest-exact",
      "options": [
        "nearest-exact",
        "bilinear",
        "area",
        "bicubic",
        "bislerp"
      ],
      "optionsFrom": {
        "class_type": "LatentUpscale",
        "input": "upscale_method"
      }
    },
    {
