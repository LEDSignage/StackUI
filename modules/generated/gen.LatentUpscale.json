{
  "id": "gen.LatentUpscale",
  "name": "Upscale Latent",
  "category": "ComfyUI / model/latent",
  "description": "LatentUpscale",
  "inPorts": [
    {
      "name": "samples",
      "type": "LATENT"
    }
