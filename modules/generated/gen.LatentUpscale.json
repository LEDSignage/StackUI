        "node": "n",
        "input": "width"
      },
      "type": "INT",
      "default": 512,
      "min": 0,
      "max": 16384,
      "step": 8
    },
    {
      "name": "height",
      "label": "Height",
      "target": {
        "node": "n",
        "input": "height"
      },
      "type": "INT",
      "default": 512,
      "min": 0,
      "max": 16384,
      "step": 8
    },
    {
      "name": "crop",
      "label": "Crop",
      "target": {
        "node": "n",
        "input": "crop"
      },
      "type": "ENUM",
      "default": "disabled",
      "options": [
        "disabled",
        "center"
      ],
      "optionsFrom": {
        "class_type": "LatentUpscale",
        "input": "crop"
      }
    }
