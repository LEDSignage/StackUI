{
  "id": "gen.LatentBlend",
  "name": "Latent Blend",
  "category": "ComfyUI / experimental",
  "description": "LatentBlend",
  "inPorts": [
    {
      "name": "samples1",
      "type": "LATENT"
    },
    {
      "name": "samples2",
      "type": "LATENT"
    }
  ],
  "outPorts": [
    {
      "name": "latent",
      "type": "LATENT"
    }
  ],
  "params": [
    {
      "name": "blend_factor",
      "label": "Blend factor",
      "target": {
        "node": "n",
        "input": "blend_factor"
      },
      "type": "FLOAT",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "LatentBlend",
      "inputs": {
        "samples1": {
          "$port": "samples1"
        },
        "samples2": {
          "$port": "samples2"
        },
        "blend_factor": 0.5
      }
    }
  },
  "outputs": {
    "latent": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "samples1": "latent"
  },
  "summary": [
    "blend_factor"
  ]
}
