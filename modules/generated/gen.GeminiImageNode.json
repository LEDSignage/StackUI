        "input": "aspect_ratio"
      },
      "type": "ENUM",
      "default": "auto",
      "options": [
        "auto",
        "1:1",
        "2:3",
        "3:2",
        "3:4",
        "4:3",
        "4:5",
        "5:4",
        "9:16",
        "16:9",
        "21:9"
