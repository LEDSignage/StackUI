{
  "id": "gen.TripoP1MultiviewToModelNode",
  "name": "Tripo P1: Multiview to Model",
  "category": "ComfyUI / partner/3d/Tripo",
  "description": "TripoP1MultiviewToModelNode — Tripo P1 multiview-to-3D from 2-4 reference images in [front, left, back, right] order. Front is required; any combination of the other three may be omitted.",
  "inPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    },
    {
      "name": "image_left",
      "type": "IMAGE",
      "optional": true
    },
    {
      "name": "image_back",
      "type": "IMAGE",
      "optional": true
    },
    {
      "name": "image_right",
      "type": "IMAGE",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "model_file",
      "type": "STRING"
    },
    {
      "name": "model_task_id",
      "type": "MODEL_TASK_ID"
    },
    {
      "name": "glb",
      "type": "FILE_3D_GLB"
    }
  ],
  "params": [
    {
      "name": "output_mode",
      "label": "Output mode",
      "target": {
        "node": "n",
        "input": "output_mode"
      },
      "type": "ENUM",
      "default": "Geometry only",
      "options": [
        "Geometry only",
        "Textured"
      ],
      "optionsFrom": {
        "class_type": "TripoP1MultiviewToModelNode",
        "input": "output_mode"
      }
    },
    {
      "name": "face_limit",
      "label": "Face limit",
      "target": {
        "node": "n",
        "input": "face_limit"
      },
      "type": "INT",
      "default": -1,
      "min": -1,
      "max": 20000
    },
    {
      "name": "model_seed",
      "label": "Model seed",
      "target": {
        "node": "n",
        "input": "model_seed"
      },
      "type": "INT",
      "default": 42
    },
    {
      "name": "auto_size",
      "label": "Auto size",
      "target": {
        "node": "n",
        "input": "auto_size"
      },
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "export_uv",
      "label": "Export uv",
      "target": {
        "node": "n",
        "input": "export_uv"
      },
      "type": "BOOLEAN",
      "default": true
    },
    {
      "name": "compress_geometry",
      "label": "Compress geometry",
      "target": {
        "node": "n",
        "input": "compress_geometry"
      },
      "type": "BOOLEAN",
      "default": false
    }
  ],
  "nodes": {
    "n": {
      "class_type": "TripoP1MultiviewToModelNode",
      "inputs": {
        "image": {
          "$port": "image"
        },
        "output_mode": "Geometry only",
        "image_left": {
          "$port": "image_left"
        },
        "image_back": {
          "$port": "image_back"
        },
        "image_right": {
          "$port": "image_right"
        },
        "face_limit": -1,
        "model_seed": 42,
        "auto_size": false,
        "export_uv": true,
        "compress_geometry": false
      }
    }
  },
  "outputs": {
    "model_file": {
      "node": "n",
      "out": 0
    },
    "model_task_id": {
      "node": "n",
      "out": 1
    },
    "glb": {
      "node": "n",
      "out": 2
    }
  },
  "summary": [
    "output_mode",
    "face_limit",
    "model_seed"
  ]
}
