        "adhere_3",
        "flex_1",
        "flex_2",
        "flex_3",
        "reimagine_1",
        "reimagine_2",
        "reimagine_3"
      ],
      "optionsFrom": {
        "class_type": "LumaRay32VideoEditNode",
