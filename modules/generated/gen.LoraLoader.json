{
  "id": "gen.LoraLoader",
  "name": "Load LoRA (Model and CLIP)",
  "category": "ComfyUI / model/loaders",
  "description": "LoraLoader — This LoRA loader is used to modify both diffusion and CLIP models, altering the way in which latents are denoised such as applying styles. Multiple LoRA nodes can be linked together.",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    },
    {
      "name": "clip",
      "type": "CLIP"
    }
  ],
  "outPorts": [
    {
      "name": "model",
      "type": "MODEL"
    },
    {
      "name": "clip",
      "type": "CLIP"
    }
  ],
  "params": [
    {
      "name": "lora_name",
      "label": "Lora name",
      "target": {
        "node": "n",
        "input": "lora_name"
      },
      "type": "ENUM",
      "default": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
      "options": [
        "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
        "gemma-3-12b-it-abliterated_lora_rank64_bf16.safetensors",
        "ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors",
        "ltx_2.3_22b_distilled_1.1_lora_dynamic_fro09_avg_rank_111_bf16.safetensors"
      ],
      "optionsFrom": {
        "class_type": "LoraLoader",
        "input": "lora_name"
      }
    },
    {
      "name": "strength_model",
      "label": "Strength model",
      "target": {
        "node": "n",
        "input": "strength_model"
      },
      "type": "FLOAT",
      "default": 1,
      "min": -100,
      "max": 100,
      "step": 0.01
    },
    {
      "name": "strength_clip",
      "label": "Strength clip",
      "target": {
        "node": "n",
        "input": "strength_clip"
      },
      "type": "FLOAT",
      "default": 1,
      "min": -100,
      "max": 100,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "LoraLoader",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "clip": {
          "$port": "clip"
        },
        "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
        "strength_model": 1,
        "strength_clip": 1
      }
    }
  },
  "outputs": {
    "model": {
      "node": "n",
      "out": 0
    },
    "clip": {
      "node": "n",
      "out": 1
    }
  },
  "passThrough": {
    "model": "model",
    "clip": "clip"
  },
  "summary": [
    "lora_name",
    "strength_model",
    "strength_clip"
  ]
}
