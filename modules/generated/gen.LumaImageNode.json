{
  "id": "gen.LumaImageNode",
  "name": "Luma Text to Image",
  "category": "ComfyUI / partner/image/Luma",
  "description": "LumaImageNode — Generates images synchronously based on prompt and aspect ratio.",
  "inPorts": [
    {
      "name": "image_luma_ref",
      "type": "LUMA_REF",
      "optional": true
    },
    {
      "name": "style_image",
      "type": "IMAGE",
      "optional": true
    },
    {
      "name": "character_image",
      "type": "IMAGE",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    }
  ],
  "params": [
    {
      "name": "prompt",
      "label": "Prompt",
      "target": {
        "node": "n",
        "input": "prompt"
      },
      "type": "STRING",
      "default": "",
      "multiline": true
    },
    {
      "name": "model",
      "label": "Model",
      "target": {
        "node": "n",
        "input": "model"
      },
      "type": "ENUM",
      "default": "photon-1",
      "options": [
        "photon-1",
        "photon-flash-1"
      ],
      "optionsFrom": {
        "class_type": "LumaImageNode",
        "input": "model"
      }
    },
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "target": {
        "node": "n",
        "input": "aspect_ratio"
      },
      "type": "ENUM",
      "default": "16:9",
      "options": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4",
        "21:9",
        "9:21"
      ],
      "optionsFrom": {
        "class_type": "LumaImageNode",
        "input": "aspect_ratio"
      }
    },
    {
      "name": "seed",
      "label": "Seed",
      "target": {
        "node": "n",
        "input": "seed"
      },
      "type": "INT",
      "default": 0,
      "min": 0
    },
    {
      "name": "style_image_weight",
      "label": "Style image weight",
      "target": {
        "node": "n",
        "input": "style_image_weight"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "LumaImageNode",
      "inputs": {
        "prompt": "",
        "model": "photon-1",
        "aspect_ratio": "16:9",
        "seed": 0,
        "style_image_weight": 1,
        "image_luma_ref": {
          "$port": "image_luma_ref"
        },
        "style_image": {
          "$port": "style_image"
        },
        "character_image": {
          "$port": "character_image"
        }
      }
    }
  },
  "outputs": {
    "image": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "prompt",
    "model",
    "aspect_ratio"
  ]
}
