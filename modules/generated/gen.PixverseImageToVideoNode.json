        "input": "quality"
      }
    },
    {
      "name": "duration_seconds",
      "label": "Duration seconds",
      "target": {
        "node": "n",
        "input": "duration_seconds"
      },
      "type": "ENUM",
      "default": "",
      "optionsFrom": {
        "class_type": "PixverseImageToVideoNode",
        "input": "duration_seconds"
      }
    },
    {
      "name": "motion_mode",
      "label": "Motion mode",
      "target": {
        "node": "n",
        "input": "motion_mode"
      },
      "type": "ENUM",
      "default": "normal",
      "options": [
        "normal",
        "fast"
      ],
      "optionsFrom": {
        "class_type": "PixverseImageToVideoNode",
        "input": "motion_mode"
