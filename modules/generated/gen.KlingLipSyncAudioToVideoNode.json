{
  "id": "gen.KlingLipSyncAudioToVideoNode",
  "name": "Kling Lip Sync Video with Audio",
  "category": "ComfyUI / partner/video/Kling",
  "description": "KlingLipSyncAudioToVideoNode — Kling Lip Sync Audio to Video Node. Syncs mouth movements in a video file to the audio content of an audio file. When using, ensure that the audio contains clearly distinguishable vocals and that the video contains a distinct face. The audio file should not be larger than 5MB. The video file should not be larger than 100MB, should have height/width between 720px and 1920px, and should be between 2s and 10s in length.",
  "inPorts": [
    {
      "name": "video",
      "type": "VIDEO"
    },
    {
      "name": "audio",
      "type": "AUDIO"
    }
  ],
  "outPorts": [
    {
      "name": "video",
      "type": "VIDEO"
    },
    {
      "name": "video_id",
      "type": "STRING"
    },
    {
      "name": "duration",
      "type": "STRING"
    }
  ],
  "params": [
    {
      "name": "voice_language",
      "label": "Voice language",
      "target": {
        "node": "n",
        "input": "voice_language"
      },
      "type": "ENUM",
      "default": "en",
      "options": [
        "zh",
        "en"
      ],
      "optionsFrom": {
        "class_type": "KlingLipSyncAudioToVideoNode",
        "input": "voice_language"
      }
    }
  ],
  "nodes": {
    "n": {
      "class_type": "KlingLipSyncAudioToVideoNode",
      "inputs": {
        "video": {
          "$port": "video"
        },
        "audio": {
          "$port": "audio"
        },
        "voice_language": "en"
      }
    }
  },
  "outputs": {
    "video": {
      "node": "n",
      "out": 0
    },
    "video_id": {
      "node": "n",
      "out": 1
    },
    "duration": {
      "node": "n",
      "out": 2
    }
  },
  "passThrough": {
    "video": "video"
  },
  "summary": [
    "voice_language"
  ]
}
