{
  "id": "gen.ResolutionSelector",
  "name": "Resolution Selector",
  "category": "ComfyUI / utilities",
  "description": "ResolutionSelector — Calculate width and height from aspect ratio and megapixel target. Useful for setting up Empty Latent Image dimensions.",
  "inPorts": [],
  "outPorts": [
    {
      "name": "width",
      "type": "INT"
    },
    {
      "name": "height",
      "type": "INT"
    }
  ],
  "params": [
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "target": {
        "node": "n",
        "input": "aspect_ratio"
      },
      "type": "ENUM",
      "default": "1:1 (Square)",
      "options": [
        "1:1 (Square)",
        "2:3 (Portrait Photo)",
        "3:2 (Photo)",
        "3:4 (Portrait Standard)",
        "4:3 (Standard)",
        "9:16 (Portrait Widescreen)",
        "16:9 (Widescreen)",
        "21:9 (Ultrawide)"
      ],
      "optionsFrom": {
        "class_type": "ResolutionSelector",
        "input": "aspect_ratio"
      }
    },
    {
      "name": "megapixels",
      "label": "Megapixels",
      "target": {
        "node": "n",
        "input": "megapixels"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0.1,
      "max": 16,
      "step": 0.1
    },
    {
      "name": "multiple",
      "label": "Multiple",
      "target": {
        "node": "n",
        "input": "multiple"
      },
      "type": "INT",
      "default": 8,
      "min": 8,
      "max": 128,
      "step": 4
    }
  ],
  "nodes": {
    "n": {
      "class_type": "ResolutionSelector",
      "inputs": {
        "aspect_ratio": "1:1 (Square)",
        "megapixels": 1,
        "multiple": 8
      }
    }
  },
  "outputs": {
    "width": {
      "node": "n",
      "out": 0
    },
    "height": {
      "node": "n",
      "out": 1
    }
  },
  "summary": [
    "aspect_ratio",
    "megapixels",
    "multiple"
  ]
}
