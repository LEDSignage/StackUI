{
  "id": "gen.RTDETR_detect",
  "name": "Run Real-Time Detection (RT-DETR)",
  "category": "ComfyUI / image/detection",
  "description": "RTDETR_detect",
  "inPorts": [
    {
      "name": "model",
      "type": "MODEL"
    },
    {
      "name": "image",
      "type": "IMAGE"
    }
  ],
  "outPorts": [
    {
      "name": "bboxes",
      "type": "BOUNDING_BOX"
    }
  ],
  "params": [
    {
      "name": "threshold",
      "label": "Threshold",
      "target": {
        "node": "n",
        "input": "threshold"
      },
      "type": "FLOAT",
      "default": 0.5
    },
    {
      "name": "class_name",
      "label": "Class name",
      "target": {
        "node": "n",
        "input": "class_name"
      },
      "type": "ENUM",
      "default": "all",
      "options": [
        "all",
        "person",
