{
  "id": "gen.TripoRetargetNode",
  "name": "Tripo: Retarget rigged model",
  "category": "ComfyUI / partner/3d/Tripo",
  "description": "TripoRetargetNode",
  "inPorts": [
    {
      "name": "original_model_task_id",
      "type": "RIG_TASK_ID"
    }
  ],
  "outPorts": [
    {
      "name": "model_file",
      "type": "STRING"
    },
    {
      "name": "retarget_task_id",
      "type": "RETARGET_TASK_ID"
    },
    {
      "name": "glb",
      "type": "FILE_3D_GLB"
    }
  ],
  "params": [
    {
      "name": "animation",
      "label": "Animation",
      "target": {
        "node": "n",
        "input": "animation"
      },
      "type": "ENUM",
      "default": "preset:idle",
      "options": [
        "preset:idle",
        "preset:walk",
        "preset:run",
        "preset:dive",
        "preset:climb",
        "preset:jump",
        "preset:slash",
        "preset:shoot",
        "preset:hurt",
        "preset:fall",
        "preset:turn",
        "preset:quadruped:walk",
        "preset:hexapod:walk",
        "preset:octopod:walk",
        "preset:serpentine:march",
        "preset:aquatic:march"
      ],
      "optionsFrom": {
        "class_type": "TripoRetargetNode",
        "input": "animation"
      }
    }
  ],
  "nodes": {
    "n": {
      "class_type": "TripoRetargetNode",
      "inputs": {
        "original_model_task_id": {
          "$port": "original_model_task_id"
        },
        "animation": "preset:idle"
      }
    }
  },
  "outputs": {
    "model_file": {
      "node": "n",
      "out": 0
    },
    "retarget_task_id": {
      "node": "n",
      "out": 1
    },
    "glb": {
      "node": "n",
      "out": 2
    }
  },
  "terminal": true,
  "summary": [
    "animation"
  ]
}
