{
  "id": "gen.FluxProUltraImageNode",
  "name": "Flux 1.1 [pro] Ultra Image",
  "category": "ComfyUI / partner/image/BFL",
  "description": "FluxProUltraImageNode — Generates images using Flux Pro 1.1 Ultra via api based on prompt and resolution.",
  "inPorts": [
    {
      "name": "image_prompt",
      "type": "IMAGE",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    }
  ],
  "params": [
    {
      "name": "prompt",
      "label": "Prompt",
      "target": {
        "node": "n",
        "input": "prompt"
      },
      "type": "STRING",
      "default": "",
      "multiline": true
    },
    {
      "name": "prompt_upsampling",
      "label": "Prompt upsampling",
      "target": {
        "node": "n",
        "input": "prompt_upsampling"
      },
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "seed",
      "label": "Seed",
      "target": {
        "node": "n",
        "input": "seed"
      },
      "type": "INT",
      "default": 0,
      "min": 0
    },
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "target": {
        "node": "n",
        "input": "aspect_ratio"
      },
      "type": "STRING",
      "default": "16:9"
    },
    {
      "name": "raw",
      "label": "Raw",
      "target": {
        "node": "n",
        "input": "raw"
      },
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "image_prompt_strength",
      "label": "Image prompt strength",
      "target": {
        "node": "n",
        "input": "image_prompt_strength"
      },
      "type": "FLOAT",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "FluxProUltraImageNode",
      "inputs": {
        "prompt": "",
        "prompt_upsampling": false,
        "seed": 0,
        "aspect_ratio": "16:9",
        "raw": false,
        "image_prompt": {
          "$port": "image_prompt"
        },
        "image_prompt_strength": 0.1
      }
    }
  },
  "outputs": {
    "image": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "prompt",
    "prompt_upsampling",
    "seed"
  ]
}
