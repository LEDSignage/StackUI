{
  "id": "gen.RecraftTextToImageNode",
  "name": "Recraft V3 Text to Image",
  "category": "ComfyUI / partner/image/Recraft",
  "description": "RecraftTextToImageNode — Generates images synchronously based on prompt and resolution.",
  "inPorts": [
    {
      "name": "recraft_style",
      "type": "RECRAFT_V3_STYLE",
      "optional": true
    },
    {
      "name": "recraft_controls",
      "type": "RECRAFT_CONTROLS",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    }
  ],
  "params": [
    {
      "name": "prompt",
      "label": "Prompt",
      "target": {
        "node": "n",
        "input": "prompt"
      },
      "type": "STRING",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "label": "Size",
      "target": {
        "node": "n",
        "input": "size"
      },
      "type": "ENUM",
      "default": "1024x1024",
      "options": [
        "1024x1024",
        "1365x1024",
        "1024x1365",
        "1536x1024",
        "1024x1536",
        "1820x1024",
        "1024x1820",
        "1024x2048",
        "2048x1024",
        "1434x1024",
        "1024x1434",
        "1024x1280",
        "1280x1024",
        "1024x1707",
        "1707x1024"
      ],
      "optionsFrom": {
        "class_type": "RecraftTextToImageNode",
        "input": "size"
      }
    },
    {
      "name": "n",
      "label": "N",
      "target": {
        "node": "n",
        "input": "n"
      },
      "type": "INT",
      "default": 1,
      "min": 1,
      "max": 6
    },
    {
      "name": "seed",
      "label": "Seed",
      "target": {
        "node": "n",
        "input": "seed"
      },
      "type": "INT",
      "default": 0,
      "min": 0
    },
    {
      "name": "negative_prompt",
      "label": "Negative prompt",
      "target": {
        "node": "n",
        "input": "negative_prompt"
      },
      "type": "STRING",
      "default": ""
    }
  ],
  "nodes": {
    "n": {
      "class_type": "RecraftTextToImageNode",
      "inputs": {
        "prompt": "",
        "size": "1024x1024",
        "n": 1,
        "seed": 0,
        "recraft_style": {
          "$port": "recraft_style"
        },
        "negative_prompt": "",
        "recraft_controls": {
          "$port": "recraft_controls"
        }
      }
    }
  },
  "outputs": {
    "image": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "prompt",
    "size",
    "n"
  ]
}
