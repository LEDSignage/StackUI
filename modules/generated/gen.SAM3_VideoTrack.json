{
  "id": "gen.SAM3_VideoTrack",
  "name": "Run SAM3 Video Track",
  "category": "ComfyUI / image/detection",
  "description": "SAM3_VideoTrack",
  "inPorts": [
    {
      "name": "images",
      "type": "IMAGE"
    },
    {
      "name": "model",
      "type": "MODEL"
    },
    {
      "name": "initial_mask",
      "type": "MASK",
      "optional": true
    },
    {
      "name": "conditioning",
      "type": "CONDITIONING",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "track_data",
      "type": "SAM3_TRACK_DATA"
    }
  ],
  "params": [
    {
      "name": "detection_threshold",
      "label": "Detection threshold",
      "target": {
        "node": "n",
        "input": "detection_threshold"
      },
      "type": "FLOAT",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "max_objects",
      "label": "Max objects",
      "target": {
        "node": "n",
        "input": "max_objects"
      },
      "type": "INT",
      "default": 4,
      "min": 0,
      "max": 64
    },
    {
      "name": "detect_interval",
      "label": "Detect interval",
      "target": {
        "node": "n",
        "input": "detect_interval"
      },
      "type": "INT",
      "default": 1,
      "min": 1
    }
  ],
  "nodes": {
    "n": {
      "class_type": "SAM3_VideoTrack",
      "inputs": {
        "images": {
          "$port": "images"
        },
        "model": {
          "$port": "model"
        },
        "detection_threshold": 0.5,
        "max_objects": 4,
        "detect_interval": 1,
        "initial_mask": {
          "$port": "initial_mask"
        },
        "conditioning": {
          "$port": "conditioning"
        }
      }
    }
  },
  "outputs": {
    "track_data": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "detection_threshold",
    "max_objects",
    "detect_interval"
  ]
}
