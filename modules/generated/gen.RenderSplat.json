{
  "id": "gen.RenderSplat",
  "name": "Render Splat",
  "category": "ComfyUI / 3d/splat",
  "description": "RenderSplat — Render a gaussian splat as an image with an anisotropic EWA rasterizer (oriented elliptical splats, antialiased, depth-sorted front-to-back). The camera comes from a camera_info input (Load / Preview 3D, or a Create Camera Info node); leave it empty to auto-frame the splat. Set frames greater than 1 for a turntable batch of images to feed a Video node.",
  "inPorts": [
    {
      "name": "splat",
      "type": "SPLAT"
    },
    {
      "name": "background",
      "type": "COLOR"
    },
    {
      "name": "bg_image",
      "type": "IMAGE",
      "optional": true
    },
    {
      "name": "camera_info",
      "type": "LOAD3D_CAMERA",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    },
    {
      "name": "mask",
      "type": "MASK"
    }
  ],
  "params": [
    {
      "name": "width",
      "label": "Width",
      "target": {
        "node": "n",
        "input": "width"
      },
      "type": "INT",
      "default": 1024,
      "min": 64,
      "max": 2048,
      "step": 8
    },
    {
      "name": "height",
      "label": "Height",
      "target": {
        "node": "n",
        "input": "height"
      },
      "type": "INT",
      "default": 1024,
      "min": 64,
      "max": 2048,
      "step": 8
    },
    {
      "name": "frames",
      "label": "Frames",
      "target": {
        "node": "n",
        "input": "frames"
      },
      "type": "INT",
      "default": 1,
      "min": -240,
      "max": 240
    },
    {
      "name": "splat_scale",
      "label": "Splat scale",
      "target": {
        "node": "n",
        "input": "splat_scale"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0.1,
      "max": 5,
      "step": 0.05
    },
    {
      "name": "sharpen",
      "label": "Sharpen",
      "target": {
        "node": "n",
        "input": "sharpen"
      },
      "type": "FLOAT",
      "default": 2,
      "min": 1,
      "max": 8,
      "step": 0.5
    },
    {
      "name": "headlight_shading",
      "label": "Headlight shading",
      "target": {
        "node": "n",
        "input": "headlight_shading"
      },
      "type": "FLOAT",
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    {
      "name": "opacity_threshold",
      "label": "Opacity threshold",
      "target": {
        "node": "n",
        "input": "opacity_threshold"
      },
      "type": "FLOAT",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "render_style",
      "label": "Render style",
      "target": {
        "node": "n",
        "input": "render_style"
      },
      "type": "ENUM",
      "default": "color",
      "options": [
        "color",
        "clay",
        "depth",
        "normal"
      ],
      "optionsFrom": {
        "class_type": "RenderSplat",
        "input": "render_style"
      }
    }
  ],
  "nodes": {
    "n": {
      "class_type": "RenderSplat",
      "inputs": {
        "splat": {
          "$port": "splat"
        },
        "width": 1024,
        "height": 1024,
        "frames": 1,
        "splat_scale": 1,
        "sharpen": 2,
        "headlight_shading": 0,
        "opacity_threshold": 0,
        "render_style": "color",
        "background": {
          "$port": "background"
        },
        "bg_image": {
          "$port": "bg_image"
        },
        "camera_info": {
          "$port": "camera_info"
        }
      }
    }
  },
  "outputs": {
    "image": {
      "node": "n",
      "out": 0
    },
    "mask": {
      "node": "n",
      "out": 1
    }
  },
  "summary": [
    "width",
    "height",
    "frames"
  ]
}
