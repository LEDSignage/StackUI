{
  "id": "gen.ColorTransfer",
  "name": "Transfer Color",
  "category": "ComfyUI / image/filters",
  "description": "ColorTransfer — Match the colors of one image to another using various algorithms.",
  "inPorts": [
    {
      "name": "image_target",
      "type": "IMAGE"
    },
    {
      "name": "image_ref",
      "type": "IMAGE"
    }
  ],
  "outPorts": [
    {
      "name": "image",
      "type": "IMAGE"
    }
  ],
  "params": [
    {
      "name": "method",
      "label": "Method",
      "target": {
        "node": "n",
        "input": "method"
      },
      "type": "ENUM",
      "default": "reinhard_lab",
      "options": [
        "reinhard_lab",
        "mkl_lab",
        "histogram"
      ],
      "optionsFrom": {
        "class_type": "ColorTransfer",
        "input": "method"
      }
    },
    {
      "name": "source_stats",
      "label": "Source stats",
      "target": {
        "node": "n",
        "input": "source_stats"
      },
      "type": "ENUM",
      "default": "per_frame",
      "options": [
        "per_frame",
        "uniform",
        "target_frame"
      ],
      "optionsFrom": {
        "class_type": "ColorTransfer",
        "input": "source_stats"
      }
    },
    {
      "name": "strength",
      "label": "Strength",
      "target": {
        "node": "n",
        "input": "strength"
      },
      "type": "FLOAT",
      "default": 1,
      "min": 0,
      "max": 10,
      "step": 0.01
    }
  ],
  "nodes": {
    "n": {
      "class_type": "ColorTransfer",
      "inputs": {
        "image_target": {
          "$port": "image_target"
        },
        "image_ref": {
          "$port": "image_ref"
        },
        "method": "reinhard_lab",
        "source_stats": "per_frame",
        "strength": 1
      }
    }
  },
  "outputs": {
    "image": {
      "node": "n",
      "out": 0
    }
  },
  "passThrough": {
    "image_target": "image"
  },
  "summary": [
    "method",
    "source_stats",
    "strength"
  ]
}
