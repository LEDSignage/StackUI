{
  "id": "gen.CreateHookKeyframe",
  "name": "Create Hook Keyframe",
  "category": "ComfyUI / advanced/hooks/scheduling",
  "description": "CreateHookKeyframe",
  "inPorts": [
    {
      "name": "prev_hook_kf",
      "type": "HOOK_KEYFRAMES",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "hook_kf",
      "type": "HOOK_KEYFRAMES"
    }
  ],
  "params": [
    {
      "name": "strength_mult",
      "label": "Strength mult",
      "target": {
        "node": "n",
        "input": "strength_mult"
      },
      "type": "FLOAT",
      "default": 1,
      "min": -20,
      "max": 20,
      "step": 0.01
    },
    {
      "name": "start_percent",
      "label": "Start percent",
      "target": {
        "node": "n",
        "input": "start_percent"
      },
      "type": "FLOAT",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.001
    }
  ],
  "nodes": {
    "n": {
      "class_type": "CreateHookKeyframe",
      "inputs": {
        "strength_mult": 1,
        "start_percent": 0,
        "prev_hook_kf": {
          "$port": "prev_hook_kf"
        }
      }
    }
  },
  "outputs": {
    "hook_kf": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "strength_mult",
    "start_percent"
  ]
}
