{
  "id": "gen.RecraftTextToVectorNode",
  "name": "Recraft V3 Text to Vector",
  "category": "ComfyUI / partner/image/Recraft",
  "description": "RecraftTextToVectorNode — Generates SVG synchronously based on prompt and resolution.",
