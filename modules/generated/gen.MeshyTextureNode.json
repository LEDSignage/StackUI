{
  "id": "gen.MeshyTextureNode",
  "name": "Meshy: Texture Model",
  "category": "ComfyUI / partner/3d/Meshy",
  "description": "MeshyTextureNode",
  "inPorts": [
    {
      "name": "meshy_task_id",
      "type": "MESHY_TASK_ID"
    },
    {
      "name": "image_style",
      "type": "IMAGE",
      "optional": true
    }
  ],
  "outPorts": [
    {
      "name": "model_file",
      "type": "STRING"
    },
    {
      "name": "meshy_task_id",
      "type": "MODEL_TASK_ID"
    },
    {
      "name": "glb",
      "type": "FILE_3D_GLB"
    },
    {
      "name": "fbx",
      "type": "FILE_3D_FBX"
    }
  ],
  "params": [
    {
      "name": "model",
      "label": "Model",
      "target": {
        "node": "n",
        "input": "model"
      },
      "type": "ENUM",
      "default": "latest",
      "options": [
        "latest"
      ],
      "optionsFrom": {
        "class_type": "MeshyTextureNode",
        "input": "model"
      }
    },
    {
      "name": "enable_original_uv",
      "label": "Enable original uv",
      "target": {
        "node": "n",
        "input": "enable_original_uv"
      },
      "type": "BOOLEAN",
      "default": true
    },
    {
      "name": "pbr",
      "label": "Pbr",
      "target": {
        "node": "n",
        "input": "pbr"
      },
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "text_style_prompt",
      "label": "Text style prompt",
      "target": {
        "node": "n",
        "input": "text_style_prompt"
      },
      "type": "STRING",
      "default": "",
      "multiline": true
    }
  ],
  "nodes": {
    "n": {
      "class_type": "MeshyTextureNode",
      "inputs": {
        "model": "latest",
        "meshy_task_id": {
          "$port": "meshy_task_id"
        },
        "enable_original_uv": true,
        "pbr": false,
        "text_style_prompt": "",
        "image_style": {
          "$port": "image_style"
        }
      }
    }
  },
  "outputs": {
    "model_file": {
      "node": "n",
      "out": 0
    },
    "meshy_task_id": {
      "node": "n",
      "out": 1
    },
    "glb": {
      "node": "n",
      "out": 2
    },
    "fbx": {
      "node": "n",
      "out": 3
    }
  },
  "terminal": true,
  "summary": [
    "model",
    "enable_original_uv",
    "pbr"
  ]
}
