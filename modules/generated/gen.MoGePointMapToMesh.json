{
  "id": "gen.MoGePointMapToMesh",
  "name": "Convert MoGe Point Map to Mesh",
  "category": "ComfyUI / image/geometry estimation",
  "description": "MoGePointMapToMesh — Convert a MoGe point map into a 3D mesh.",
  "inPorts": [
    {
      "name": "moge_geometry",
      "type": "MOGE_GEOMETRY"
    }
  ],
  "outPorts": [
    {
      "name": "mesh",
      "type": "MESH"
    }
  ],
  "params": [
    {
      "name": "batch_index",
      "label": "Batch index",
      "target": {
        "node": "n",
        "input": "batch_index"
      },
      "type": "INT",
      "default": 0,
      "min": 0,
      "max": 4096
    },
    {
      "name": "decimation",
      "label": "Decimation",
      "target": {
        "node": "n",
        "input": "decimation"
      },
      "type": "INT",
      "default": 1,
      "min": 1,
      "max": 8
    },
    {
      "name": "discontinuity_threshold",
      "label": "Discontinuity threshold",
      "target": {
        "node": "n",
        "input": "discontinuity_threshold"
      },
      "type": "FLOAT",
      "default": 0.04,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "texture",
      "label": "Texture",
      "target": {
        "node": "n",
        "input": "texture"
      },
      "type": "BOOLEAN",
      "default": true
    }
  ],
  "nodes": {
    "n": {
      "class_type": "MoGePointMapToMesh",
      "inputs": {
        "moge_geometry": {
          "$port": "moge_geometry"
        },
        "batch_index": 0,
        "decimation": 1,
        "discontinuity_threshold": 0.04,
        "texture": true
      }
    }
  },
  "outputs": {
    "mesh": {
      "node": "n",
      "out": 0
    }
  },
  "summary": [
    "batch_index",
    "decimation",
    "discontinuity_threshold"
  ]
}
