      "name": "positive",
      "type": "CONDITIONING"
    },
    {
      "name": "negative",
      "type": "CONDITIONING"
    },
    {
      "name": "reference_audio",
      "type": "AUDIO"
    },
    {
      "name": "audio_vae",
      "type": "VAE"
    }
  ],
  "outPorts": [
