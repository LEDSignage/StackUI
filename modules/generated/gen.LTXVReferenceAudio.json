      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.001
    }
  ],
  "nodes": {
    "n": {
      "class_type": "LTXVReferenceAudio",
      "inputs": {
        "model": {
          "$port": "model"
        },
        "positive": {
          "$port": "positive"
        },
        "negative": {
